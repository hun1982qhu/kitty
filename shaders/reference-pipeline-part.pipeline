# Kitty Custom Shader：The pipeline part 全配置项中文参考模板。
#
# 本文件没有被 kitty.conf 的 custom_shaders 引用，不会自动生效。
# 若将来启用它，Kitty 会按组顺序执行 reference-shader-part.slang。

# ------------------------------ 顶层指令 ------------------------------

# 渲染插槽。目前唯一支持的值是 end，表示在 Kitty 自身完成渲染后执行。
# end 也是默认值，所以实际配置中可以省略本行。
slot end

# 声明可供所有组访问的命名纹理。只应声明实际需要的纹理，否则会额外分配
# 离屏 framebuffer：a、b 是每次绘制使用的临时纹理；persist 会跨帧保留。
textures a b persist

# Pipeline 级 shader 常量覆盖，作用于所有组。
# 格式：var <类型> <名称> [=] <值>
# 支持 int、uint、float、double、bool 及其向量类型，如 float2/float3/float4。
# 仅当 shader 存在同名 static const 时才有可覆盖的目标。
var float REFERENCE_GAIN = 1.0

# ------------------------------- 渲染组 -------------------------------
# 一个 pipeline 最多包含 16 个组；同组多个 shader 按书写顺序串联执行。

startgroup
    # 本组依次运行的 shader 名称。优先查找当前配置目录的 shaders/，随后
    # 查找 Kitty 自带 shader；扩展名 .slang 不写。
    shaders reference-shader-part

    # 组级常量覆盖；与顶层 var 同名时，本组值优先。
    var float REFERENCE_GAIN = 1.0

    # 本组渲染区域左下角的 UV 坐标，默认 0 0。最终组始终覆盖全屏，因而
    # viewport_pos/viewport_size 对最终组无效。
    viewport_pos 0 0

    # 本组渲染区域的 UV 宽度和高度，默认 1 1。
    viewport_size 1 1

    # 输出目标：default、a、b 或 persist。
    # default 会更新 backbuffer；写入命名纹理时 backbuffer 保持不变。
    # 最终组必须输出到 default。本组不是最终组，因此用 a 展示离屏输出。
    output_texture a

    # 触发本组动画的事件；多个事件用 | 分隔。省略时本组每帧无条件执行。
    animation_start pointer-left-button-press | user-activity

    # 停止条件可为事件、毫秒整数或 never，也可用 | 组合。
    # 省略时使用 kitty.conf 的 cursor_stop_blinking_after 作为持续时间。
    animation_stop user-idle | 1500

    # 将原始时间映射为 t.animation_progress 的 CSS easing 曲线。
    # 命名值：linear、ease、ease-in、ease-out、ease-in-out、step-start、step-end。
    # 也支持 cubic-bezier(x1,y1,x2,y2)、linear(p0,p1,...)、steps(n,start|end)。
    animation_curve ease-out

    # 动画帧间隔（毫秒），默认 50。越小越平滑但 GPU 绘制越频繁；实际值
    # 不会小于 kitty.conf 的 repaint_delay。0 表示只在内容/事件变化时重绘。
    animation_step 16
endgroup

startgroup
    # 将本组附着到前一组：自动跟随其启停，并共享相同动画起始时间。
    # 第一组不能 attach；附着组仍可另写 animation_start，任一条件均可激活。
    attach

    shaders reference-shader-part

    # default 是最终组唯一允许的输出目标；它将结果写回 backbuffer。
    # 官方语法是下一行，但 Kitty 0.49.1 显式解析 default 时会误判为命名纹理；
    # 省略该指令得到的默认行为完全相同，同时可避开此版本的解析问题。
    # output_texture default
endgroup
